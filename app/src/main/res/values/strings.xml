    <string name="permission_title">Enable app locking</string>
    <string name="permission_intro">Earn it! uses Accessibility to block apps only after your rest timer reaches 0:00.</string>
    <string name="permission_timing_title">When blocking runs</string>
    <string name="permission_timing_body">Only during the decision lock after a rest timer expires.</string>
    <string name="permission_observation_title">What it checks</string>
    <string name="permission_observation_body">During a workout, it remembers the latest foreground app package name so blocking can start at 0:00, even if that app is already open. Apps remain usable throughout the rest countdown.</string>
    <string name="permission_action_title">What it does</string>
    <string name="permission_action_body">During the decision lock, if an app is not allowed or essential, Earn it! sends you to Android Home and opens the workout decision screen.</string>
    <string name="permission_exclusions_title">What it does not do</string>
    <string name="permission_exclusions_body">It never reads screen text, messages, passwords, form contents, notification contents, browser contents, or Accessibility node trees.</string>
    <string name="permission_storage_title">Where data stays</string>
    <string name="permission_storage_body">Workout routines, history, profile, settings, and session data use local storage and are not uploaded to an Earn it! backend. Foreground package observations stay local. Android backup or restore may handle app data separately.</string>
    <string name="permission_consent">I understand and want to enable Accessibility for app locking.</string>
